@page "/"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using MyCyberQuiz.Shared.DTOs
@using MyCyberQuiz.UI.Services
@using MyCyberQuiz.UI.Services.Interfaces
@inject NavigationManager NavigationManager
@inject IFrontendQuizService QuizService
@rendermode InteractiveServer




<div class="container mt-5">
    <h2 class="mb-4">Välj ett Quiz</h2>

    @* Visar en laddningssnurra medan vi väntar på API:et *@
    @if (categories == null)
    {
        <div class="d-flex justify-content-center mt-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Laddar...</span>
            </div>
        </div>
    }
    else if (!categories.Any())
    {
        <p>Inga kategorier hittades i databasen.</p>
    }
    else
    {
        <div class="accordion shadow-sm" id="categoryAccordion">

            @* Yttre loop: Loopar igenom alla kategorier *@
            @foreach (var category in categories)
            {
                <div class="accordion-item">
                    <h2 class="accordion-header" id="heading-@category.Id">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@category.Id" aria-expanded="false" aria-controls="collapse-@category.Id">
                            <strong>@category.Name</strong>
                        </button>
                    </h2>

                    <div id="collapse-@category.Id" class="accordion-collapse collapse" aria-labelledby="heading-@category.Id" data-bs-parent="#categoryAccordion">
                        <div class="accordion-body bg-light">
                            <div class="row g-4">

                                @* Inre loop: Loopar igenom underkategorierna för den aktuella kategorin *@
                                @foreach (var subCategory in category.SubCategories)
                                {
                                    <div class="col-md-4 mb-3">
                                        <div class="card h-100 shadow-sm hover-effect @(subCategory.IsCompleted ? "border border-success border-2" : (subCategory.IsLocked ? "border border-secondary opacity-75" : "border border-primary"))">

                                            <div class="card-body d-flex flex-column">
                                                <h5 class="card-title d-flex justify-content-between align-items-center @(subCategory.IsLocked ? "text-muted" : "text-dark")">
                                                    @subCategory.Name

                                                    @if (subCategory.IsCompleted)
                                                    {
                                                        <i class="bi bi-check-circle-fill text-success fs-4" title="Avklarat!"></i>
                                                    }
                                                    else if (subCategory.IsLocked)
                                                    {
                                                        <i class="bi bi-lock-fill text-secondary fs-5" title="Låst"></i>
                                                    }
                                                </h5>

                                                <div class="mt-auto pt-3">
                                                    <button class="btn w-100 @(subCategory.IsCompleted ? "btn-outline-success fw-bold" : (subCategory.IsLocked ? "btn-secondary" : "btn-primary shadow-sm"))"
                                                            disabled="@subCategory.IsLocked"
                                                            @onclick="() => StartQuiz(subCategory.Id)">

                                                        @if (subCategory.IsLocked)
                                                        {
                                                            <span><i class="bi bi-lock me-1"></i> Låst</span>
                                                        }
                                                        else if (subCategory.IsCompleted)
                                                        {
                                                            <span><i class="bi bi-arrow-repeat me-1"></i> Spela igen</span>
                                                        }
                                                        else
                                                        {
                                                            <span><i class="bi bi-play-circle-fill me-1"></i> Starta Quiz</span>
                                                        }
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<CategoryDto> categories;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            categories = await QuizService.GetQuizMenuAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Fel vid hämtning av kategorier: {ex.Message}");
            categories = new List<CategoryDto>(); // Visa ett tomt state istället för att krascha
        }
    }

    private void StartQuiz(int subCategoryId)
    {
        NavigationManager.NavigateTo($"/QuizComponents/{subCategoryId}");
    }



}